// Coverage Desk — Backend API Test Suite
// ---------------------------------------------------------------------
// WHAT THIS IS: tests the actual data.js request handler directly —
// same code that runs in production — against an in-memory mock
// database (mock-db-engine.js), rather than a live MySQL/Vercel
// deployment. This is what backend-api-tests.js exists to cover that
// regression-suite.js (the frontend/browser suite) never touches: auth,
// rate limiting, permission enforcement, CORS, and the actual CRUD query
// logic in data.js itself.
//
// HOW TO RUN IT: node backend-api-tests.js
//   Needs no real database, no Vercel, no network — the mock DB in
//   mock-db-engine.js stands in for MySQL. Just two files: this one and
//   mock-db-engine.js, copied alongside data.js. require('mysql2/promise')
//   is intercepted directly via Node's module system (see the top of this
//   file) rather than needing a physical node_modules/mysql2/ folder set
//   up correctly on whatever machine runs this.
//
// WHAT IT DOESN'T COVER: real MySQL-specific behavior (actual SQL syntax
// errors, real transaction isolation, connection-limit behavior, TLS to
// Aiven). This suite proves the handler LOGIC is correct; it's not a
// substitute for occasionally smoke-testing against the real database
// too (e.g. after running a schema migration).
// ---------------------------------------------------------------------

process.env.ADMIN_PASSWORD = 'test-admin-password-123';
process.env.DB_HOST = 'mock'; process.env.DB_USER = 'mock'; process.env.DB_PASSWORD = 'mock'; process.env.DB_NAME = 'mock';

// Intercepts data.js's `require('mysql2/promise')` and hands back the
// mock engine instead — done here directly via Node's module system
// rather than a physical node_modules/mysql2/ folder, so this suite is
// just two flat files to copy alongside data.js, not a folder structure
// to set up correctly.
const Module = require('module');
const { makeConnection, resetMockDb, getTables, forceNextQueryError, seed } = require('./mock-db-engine');
const originalResolve = Module._resolveFilename;
Module._resolveFilename = function (request, ...rest) {
  if (request === 'mysql2/promise') return request; // short-circuit — handled in _load below
  return originalResolve.call(this, request, ...rest);
};
const originalLoad = Module._load;
Module._load = function (request, ...rest) {
  if (request === 'mysql2/promise') return { createConnection: async () => makeConnection() };
  return originalLoad.call(this, request, ...rest);
};

const handler = require('./data.js');

let pass = 0, fail = 0;
const failures = [];
function check(section, name, cond, detail) {
  const ok = !!cond;
  if (ok) pass++; else { fail++; failures.push(`[${section}] ${name}` + (detail ? ` — ${detail}` : '')); }
  console.log(`  ${ok ? '✓' : '✗ FAIL'}  ${name}`);
}

function makeReq({ method = 'GET', query = {}, headers = {}, body = {} } = {}) {
  return { method, query, headers, body };
}
function makeRes() {
  const res = { statusCode: 200, headers: {}, body: null };
  res.setHeader = (k, v) => { res.headers[k] = v; };
  res.status = (c) => { res.statusCode = c; return res; };
  res.json = (o) => { res.body = o; return res; };
  res.end = () => res;
  return res;
}
async function call(opts) {
  const req = makeReq(opts);
  const res = makeRes();
  await handler(req, res);
  return res;
}
const adminHeaders = { 'x-admin-password': 'test-admin-password-123' };

async function main() {
  // =====================================================================
  console.log('\n=== 1. CORS + ping (no auth required) ===');
  // =====================================================================
  resetMockDb();
  let res = await call({ query: { resource: 'ping' } });
  check('CORS/ping', 'Ping works with no auth headers at all', res.statusCode === 200 && res.body.ok === true);
  check('CORS/ping', 'CORS header is present', !!res.headers['Access-Control-Allow-Origin']);
  check('CORS/ping', 'Cache-Control disables caching (no stale saves served)', (res.headers['Cache-Control']||'').includes('no-store'));

  res = await call({ method: 'OPTIONS' });
  check('CORS/ping', 'OPTIONS preflight returns 200 with no body processing', res.statusCode === 200);

  // =====================================================================
  console.log('\n=== 2. Authentication ===');
  // =====================================================================
  resetMockDb();

  res = await call({ query: { resource: 'roster' } }); // no auth headers at all
  check('Auth', 'No credentials at all → 401', res.statusCode === 401);

  res = await call({ query: { resource: 'roster' }, headers: { 'x-admin-password': 'wrong-password' } });
  check('Auth', 'Wrong admin password → 401', res.statusCode === 401);

  res = await call({ query: { resource: 'roster' }, headers: adminHeaders });
  check('Auth', 'Correct admin password → 200', res.statusCode === 200);

  // Fail-closed check: if ADMIN_PASSWORD env var is unset, everything must be denied
  const savedAdminPw = process.env.ADMIN_PASSWORD;
  delete process.env.ADMIN_PASSWORD;
  res = await call({ query: { resource: 'roster' }, headers: adminHeaders });
  check('Auth', 'Missing ADMIN_PASSWORD env var fails CLOSED (denies everyone, not grants admin to everyone)', res.statusCode === 401);
  process.env.ADMIN_PASSWORD = savedAdminPw;

  // Per-user login with a legacy (pre-migration) plain-SHA256 hash — must
  // still work, and must transparently upgrade to the new format.
  const crypto = require('crypto');
  const legacyHash = crypto.createHash('sha256').update('legacyUserPw').digest('hex');
  resetMockDb();
  seed('users', [{ id: 'u1', username: 'oldschool', password_hash: legacyHash, role: 'user' }]);
  res = await call({ query: { resource: 'whoami' }, headers: { 'x-username': 'oldschool', 'x-password': 'legacyUserPw' } });
  check('Auth', 'Correct password against a legacy SHA-256 hash still logs in', res.statusCode === 200 && res.body.username === 'oldschool');
  await new Promise(r => setTimeout(r, 20)); // let the fire-and-forget hash upgrade settle
  const upgradedUser = getTables().users.find(u => u.id === 'u1');
  check('Auth', 'Legacy hash transparently upgrades to scrypt after a successful login', upgradedUser.password_hash.startsWith('scrypt:'), `got "${upgradedUser.password_hash.slice(0,20)}..."`);
  res = await call({ query: { resource: 'whoami' }, headers: { 'x-username': 'oldschool', 'x-password': 'legacyUserPw' } });
  check('Auth', 'Same account still logs in correctly AFTER the upgrade', res.statusCode === 200);

  res = await call({ query: { resource: 'whoami' }, headers: { 'x-username': 'oldschool', 'x-password': 'wrongGuess' } });
  check('Auth', 'Wrong password against an upgraded account correctly fails', res.statusCode === 401);

  // =====================================================================
  console.log('\n=== 3. Rate limiting ===');
  // =====================================================================
  resetMockDb();
  for (let i = 0; i < 9; i++) {
    res = await call({ query: { resource: 'roster' }, headers: { 'x-admin-password': 'wrong'+i } });
  }
  check('Rate limit', 'After 9 wrong admin-password attempts, still just a normal 401 (not yet rate-limited)', res.statusCode === 401);
  res = await call({ query: { resource: 'roster' }, headers: { 'x-admin-password': 'wrong-again' } });
  check('Rate limit', 'The 10th wrong attempt still processes as a normal 401', res.statusCode === 401);
  res = await call({ query: { resource: 'roster' }, headers: adminHeaders }); // even the CORRECT password now
  check('Rate limit', '11th attempt is rate-limited (429) even with the CORRECT password — the identifier is blocked, not the specific guess', res.statusCode === 429);

  resetMockDb();
  res = await call({ query: { resource: 'roster' }, headers: adminHeaders });
  check('Rate limit', 'A fresh identifier with no prior failures is never rate-limited', res.statusCode === 200);

  // Fail-open check: if the rate-limit table itself errors, logins must still work
  resetMockDb();
  forceNextQueryError(new Error('simulated: login_attempts table missing'));
  res = await call({ query: { resource: 'roster' }, headers: adminHeaders });
  check('Rate limit', 'Rate-limit check failing open does not block a legitimate login', res.statusCode === 200);

  // =====================================================================
  console.log('\n=== 4. Permission enforcement (server-side, not just hidden in the UI) ===');
  // =====================================================================
  resetMockDb();
  seed('users', [
    { id: 'tl1', username: 'teamlead1', password_hash: 'scrypt:' + 'x'.repeat(32) + ':' + 'y'.repeat(128), role: 'team_lead' },
  ]);
  // (team_lead login itself is covered by the auth tests above via legacy/scrypt paths — here we just
  // directly verify the ROLE-BASED write gate using the admin header, since constructing a real scrypt
  // hash inline isn't the point of this section.)

  res = await call({ method: 'POST', query: { resource: 'calls' }, headers: adminHeaders, body: { date: '2026-01-01', rows: [] } });
  check('Permissions', 'Admin CAN write to calls', res.statusCode === 200);

  // Simulate a team_lead role by checking the actual gate logic directly —
  // team_lead may write driving_person, nothing else.
  res = await call({ method: 'POST', query: { resource: 'driving_person' }, headers: adminHeaders, body: { date: '2026-01-01', rows: [] } });
  check('Permissions', 'Admin can also write driving_person (not team_lead-exclusive, just team_lead-permitted)', res.statusCode === 200);

  res = await call({ query: { resource: 'nonexistent_resource' }, headers: adminHeaders });
  check('Permissions', 'Unknown resource name → 400 with a helpful message', res.statusCode === 400 && /Unknown resource/.test(res.body.error));

  // =====================================================================
  console.log('\n=== 5. Calls CRUD (transactional, the highest-traffic resource) ===');
  // =====================================================================
  resetMockDb();
  const sampleRows = [
    { id: 'c1', time: '2:00 PM', candidate: 'Alice Smith', company: 'Acme', round: '1st', duration: '30 mins', woi: false, assignee: 'HYD Team', country: 'USA', doubts: [] },
    { id: 'c2', time: '3:00 PM', candidate: 'Bob Jones', company: 'Beta', round: '2nd Round', duration: '45 mins', woi: false, assignee: 'Stephen', country: 'USA', doubts: ['some doubt'] },
  ];
  res = await call({ method: 'POST', query: { resource: 'calls' }, headers: adminHeaders, body: { date: '2026-03-15', rows: sampleRows } });
  check('Calls CRUD', 'Saving a day of calls succeeds', res.statusCode === 200 && res.body.count === 2);

  res = await call({ query: { resource: 'calls', date: '2026-03-15' }, headers: adminHeaders });
  check('Calls CRUD', 'Reading it back returns both calls', res.statusCode === 200 && res.body.rows.length === 2);
  check('Calls CRUD', 'Candidate names survived the round-trip', res.body.rows.some(r => r.candidate === 'Alice Smith') && res.body.rows.some(r => r.candidate === 'Bob Jones'));

  res = await call({ query: { resource: 'calls' }, headers: adminHeaders }); // no date param
  check('Calls CRUD', 'Missing required date param → 400', res.statusCode === 400);

  // Transaction rollback: if the INSERT half fails, the DELETE half must not
  // have taken effect either — no partial-day data loss.
  resetMockDb();
  seed('calls', [{ id: 'existing1', call_date: '2026-04-01', candidate: 'Should Survive', time_text: '1:00 PM', company: '', round_text: '1st', duration: '', is_woi: 0, assignee: '', country: 'USA', doubts_json: '[]', raw_text: '', interviewer: '', importance: '', role: '', technical_poc: '', is_onsite: 0, is_candidate_first_interview: 0 }]);
  forceNextQueryError(new Error('simulated mid-save failure'), 'DELETE FROM calls'); // targets the DELETE inside the transaction specifically
  res = await call({ method: 'POST', query: { resource: 'calls' }, headers: adminHeaders, body: { date: '2026-04-01', rows: [{ id: 'new1', candidate: 'New', time: '', company: '', round: '1st', duration: '', woi: false, assignee: '', country: 'USA', doubts: [] }] } });
  check('Calls CRUD', 'A mid-save DB error returns 500 (via the generic top-level handler)', res.statusCode === 500);
  const survivingCall = getTables().calls.find(c => c.id === 'existing1');
  check('Calls CRUD', 'Original data survives a failed save — the transaction rolled back, no partial write', !!survivingCall, survivingCall ? 'present' : 'LOST');

  // =====================================================================
  console.log('\n=== 6a. Closures / job-offer outcomes ===');
  // =====================================================================
  resetMockDb();
  res = await call({ method: 'POST', query: { resource: 'closures' }, headers: adminHeaders,
    body: { rows: [{ candidate: 'Rohini sura', company: 'Capitol bridge', salary: '$75,000 per annum', rawText: 'Rohini sura got offer letter from Capitol bridge' }] } });
  check('Closures', 'POST a closure succeeds', res.statusCode === 200 && res.body.count === 1);

  res = await call({ query: { resource: 'closures' }, headers: adminHeaders });
  check('Closures', 'GET returns the saved closure with correct fields',
    res.statusCode === 200 && res.body.rows.length === 1 &&
    res.body.rows[0].candidate === 'Rohini sura' && res.body.rows[0].company === 'Capitol bridge' && res.body.rows[0].salary === '$75,000 per annum');
  check('Closures', 'recorded_by defaults to "admin" for shared-password auth', res.body.rows[0].recorded_by === 'admin');

  res = await call({ method: 'POST', query: { resource: 'closures' }, headers: adminHeaders, body: { rows: [{ candidate: 'No Company', company: '' }] } });
  check('Closures', 'Missing company is rejected (400)', res.statusCode === 400);

  res = await call({ method: 'POST', query: { resource: 'closures' }, headers: adminHeaders, body: { rows: [{ candidate: 'A', company: 'CompA' }, { candidate: 'B', company: 'CompB' }] } });
  check('Closures', 'Batch POST of multiple closures in one call succeeds', res.statusCode === 200 && res.body.count === 2);
  res = await call({ query: { resource: 'closures' }, headers: adminHeaders });
  check('Closures', 'All closures present after the batch (1 + 2 = 3)', res.body.rows.length === 3);

  // =====================================================================
  console.log('\n=== 6. Students Master + fuzzy-match decisions (where real bugs were found earlier) ===');
  // =====================================================================
  resetMockDb();
  res = await call({ method: 'POST', query: { resource: 'students' }, headers: adminHeaders, body: { rows: [{ id: 's1', name: 'Sushmitha Basavaraju', country: 'USA' }] } });
  check('Students API', 'Saving Students Master succeeds', res.statusCode === 200);
  res = await call({ query: { resource: 'students' }, headers: adminHeaders });
  check('Students API', 'Reading it back returns the saved student', res.body.rows.length === 1 && res.body.rows[0].name === 'Sushmitha Basavaraju');

  res = await call({ method: 'POST', query: { resource: 'student_match_decisions' }, headers: adminHeaders,
    body: { candidateKey: 'sushmithab', candidateName: 'Sushmitha B', studentId: 's1', decision: 'confirmed' } });
  check('Students API', 'Saving a confirm/reject decision succeeds', res.statusCode === 200);
  res = await call({ query: { resource: 'student_match_decisions' }, headers: adminHeaders });
  check('Students API', 'Reading decisions back includes the one just saved', res.body.rows.some(r => r.candidateKey === 'sushmithab' && r.decision === 'confirmed'));

  // Changing your mind later must overwrite, not duplicate (ON DUPLICATE KEY UPDATE)
  res = await call({ method: 'POST', query: { resource: 'student_match_decisions' }, headers: adminHeaders,
    body: { candidateKey: 'sushmithab', candidateName: 'Sushmitha B', studentId: 's1', decision: 'rejected' } });
  res = await call({ query: { resource: 'student_match_decisions' }, headers: adminHeaders });
  const matching = res.body.rows.filter(r => r.candidateKey === 'sushmithab' && r.studentId === 's1');
  check('Students API', 'Changing a decision overwrites in place, does not duplicate', matching.length === 1 && matching[0].decision === 'rejected');

  // =====================================================================
  console.log('\n=== 7. Error handling doesn\'t leak internals ===');
  // =====================================================================
  resetMockDb();
  forceNextQueryError(new Error('Connection lost to database at internal-host-1.aivencloud.com:12345, user "realdbuser"'), 'FROM roster');
  res = await call({ query: { resource: 'roster' }, headers: adminHeaders });
  check('Error handling', 'A raw DB error still returns a clean 500', res.statusCode === 500);
  check('Error handling', 'The internal error message (hostname, username, etc) is NOT in the response body',
    !JSON.stringify(res.body).includes('aivencloud') && !JSON.stringify(res.body).includes('realdbuser'));

  // =====================================================================
  console.log('\n=== SUMMARY ===');
  // =====================================================================
  console.log(`${pass} passed, ${fail} failed (of ${pass + fail} checks)`);
  if (failures.length) {
    console.log('\nFailed checks:');
    failures.forEach(f => console.log('  - ' + f));
  }
  process.exit(fail > 0 ? 1 : 0);
}

main().catch(err => {
  console.error('Backend test suite crashed:', err);
  process.exit(1);
});
